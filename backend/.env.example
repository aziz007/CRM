# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/crm
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:4200

# Backblaze B2 (S3-compatible API). Create a bucket set to Private and an application key
# limited to that bucket. The endpoint and region are shown on the bucket details page,
# for example https://s3.us-west-004.backblazeb2.com and us-west-004.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
